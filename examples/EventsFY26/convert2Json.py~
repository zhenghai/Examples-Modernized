import json
import io
import re
import pandas as pd

# Define paths
csv_filename = "Events Reporting Spreadsheet_TestFY26cleaned.csv"
json_filename = "venue_hierarchy.json"

# 1. Load the CSV safely, handling potential encoding deviations
try:
    df = pd.read_csv(csv_filename, encoding="utf-8-sig")
except UnicodeDecodeError:
    df = pd.read_csv(csv_filename, encoding="latin-1")

# Clean column white spaces
df.columns = df.columns.str.strip()

# Explicit mappings based on your CSV structure
attendance_col = "Actual Attendance #"
source_location_col = "Location / Room"
target_building_col = "Building / Outside / Off Campus / Virtual"

# 2. Extract digits only from the attendance figures and convert to numeric integers
def parse_attendance(val):
    if pd.isna(val):
        return 0
    digits = re.sub(r"\D", "", str(val))
    return int(digits) if digits != "" else 0

df[attendance_col] = df[attendance_col].apply(parse_attendance)

# Drop entries that don't have valid locations or any attendance
df = df.dropna(subset=[target_building_col, source_location_col])
df = df[df[attendance_col] > 0]

# Calculate grand total attendance across the entire dataset to compute percentage metrics
total_attendance = df[attendance_col].sum()

# 3. Helper function to assign index keys based on building category properties
def get_index_tier(venue_name):
    venue_clean = str(venue_name).strip().upper()
    if venue_clean == "VIRTUAL":
        return 0
    elif venue_clean == "OFF CAMPUS":
        return 1
    elif venue_clean == "OUTSIDE":
        return 2
    else:
        return 3 # Encompasses internal building locations (Art Museum, JRR, McCosh, etc.)

# 4. Construct the structured parent JSON tree array
json_output = {
    "name": "Venue",
    "children": []
}

# Group rows based on the top layer categorizations
venue_groups = df.groupby(target_building_col)

for venue_name, venue_df in venue_groups:
    parent_node = {
        "name": str(venue_name),
        "children": []
    }
    
    # Sum up actual attendance metrics grouped by specific location rooms
    location_aggregates = venue_df.groupby(source_location_col)[attendance_col].sum().items()
    
    for loc_name, loc_attendance_sum in location_aggregates:
        # Calculate percentage share metrics from the total ecosystem sum
        percentage_value = (float(loc_attendance_sum) / total_attendance) if total_attendance > 0 else 0.0
        
        # Build leaf node child map array profiles
        leaf_node = {
            "index": get_index_tier(venue_name),
            "name": str(loc_name),
            "value": percentage_value
        }
        parent_node["children"].append(leaf_node)
        
    json_output["children"].append(parent_node)

# 5. Output the structural schema straight out into a dedicated JSON file
with open(json_filename, "w", encoding="utf-8") as json_file:
    json.dump(json_output, json_file, indent=2, ensure_ascii=False)

print(f"Success! Hierarchical tree node elements mapped directly into '{json_filename}' successfully.")
