import json
import os
import shutil
import tempfile
import zipfile

import geopandas as gpd
import requests

============================================================
CONFIG
============================================================

DATA_FILE = "NatureNationSurveyZipDistance.json"
OUTPUT_FILE = "zip-boundaries.geojson"

Official Census 2020 national ZCTA shapefile.

ZCTA_URL = (
"https://www2.census.gov/geo/tiger/TIGER2020/ZCTA5/"
"tl_2020_us_zcta510.zip"
)

How far beyond the survey ZIPs to include surrounding ZIPs.
1.0 degrees is roughly 60-70 miles in this part of the US.
Increase this to 1.5 or 2.0 if you want a larger surrounding map.

BUFFER_DEGREES = 1.0

============================================================
LOAD SURVEY ZIP CODES
============================================================

print()
print("=" * 70)
print("Nature Nation ZIP boundary generator")
print("=" * 70)
print()

if not os.path.exists(DATA_FILE):
raise FileNotFoundError(
f"Could not find {DATA_FILE}. "
"Put this script in the same folder as the JSON file."
)

with open(DATA_FILE, "r", encoding="utf-8") as f:
survey_data = json.load(f)

def normalize_zip(value):
"""
Convert ZIP values to five-character strings.

Examples:
    2114    -> 02114
    "08544" -> 08544
    8544    -> 08544
"""

if value is None:
    return ""

digits = "".join(
    c for c in str(value).strip()
    if c.isdigit()
)

if not digits:
    return ""

return digits.zfill(5)


survey_zips = {
normalize_zip(zip_code)
for zip_code in survey_data.keys()
}

survey_zips.discard("")

print(
f"Survey ZIP codes found: {len(survey_zips)}"
)

print(
sorted(survey_zips)
)

print()

============================================================
DOWNLOAD CENSUS DATA
============================================================

temp_dir = tempfile.mkdtemp(
prefix="zcta_download_"
)

zip_path = os.path.join(
temp_dir,
"zcta.zip"
)

try:

print(
    "Downloading official 2020 Census ZCTA shapefile..."
)

print(
    ZCTA_URL
)

response = requests.get(
    ZCTA_URL,
    stream=True,
    timeout=300
)

response.raise_for_status()


total = int(
    response.headers.get(
        "content-length",
        0
    )
)

downloaded = 0


with open(
    zip_path,
    "wb"
) as f:

    for chunk in response.iter_content(
        chunk_size=1024 * 1024
    ):

        if not chunk:
            continue

        f.write(chunk)

        downloaded += len(chunk)

        if total:

            percent = (
                downloaded /
                total *
                100
            )

            print(
                f"\rDownloaded "
                f"{downloaded / 1024 / 1024:.1f} MB "
                f"({percent:.1f}%)",
                end="",
                flush=True
            )


print()
print()
print("Download complete.")
print()


# ========================================================
# EXTRACT
# ========================================================

extract_dir = os.path.join(
    temp_dir,
    "zcta"
)

os.makedirs(
    extract_dir,
    exist_ok=True
)


print(
    "Extracting Census shapefile..."
)


with zipfile.ZipFile(
    zip_path,
    "r"
) as archive:

    archive.extractall(
        extract_dir
    )


# ========================================================
# FIND SHAPEFILE
# ========================================================

shapefile = None


for filename in os.listdir(
    extract_dir
):

    if filename.lower().endswith(
        ".shp"
    ):

        shapefile = os.path.join(
            extract_dir,
            filename
        )

        break


if shapefile is None:

    raise FileNotFoundError(
        "Could not find a .shp file "
        "inside the Census download."
    )


print(
    "Shapefile:",
    shapefile
)

print()


# ========================================================
# READ CENSUS ZCTA DATA
# ========================================================

print(
    "Reading Census ZCTA boundaries..."
)

zctas = gpd.read_file(
    shapefile
)


print(
    f"Census ZCTAs loaded: {len(zctas):,}"
)

print()


# ========================================================
# IDENTIFY ZIP COLUMN
# ========================================================

possible_columns = [
    "ZCTA5CE20",
    "ZCTA5CE10",
    "GEOID20",
    "GEOID"
]


zip_column = None


for column in possible_columns:

    if column in zctas.columns:

        zip_column = column
        break


if zip_column is None:

    raise RuntimeError(
        "Could not find the ZIP/ZCTA column. "
        f"Available columns: "
        f"{list(zctas.columns)}"
    )


print(
    "ZIP column:",
    zip_column
)

print()


zctas["ZIP"] = (
    zctas[zip_column]
    .astype(str)
    .str.replace(
        ".0",
        "",
        regex=False
    )
    .str.zfill(5)
)


# ========================================================
# FIRST: SELECT SURVEY ZIPS
# ========================================================

survey_boundaries = zctas[
    zctas["ZIP"].isin(
        survey_zips
    )
].copy()


print(
    "Survey ZIP boundaries found:",
    len(survey_boundaries)
)


missing = sorted(
    survey_zips -
    set(
        survey_boundaries["ZIP"]
    )
)


if missing:

    print(
        "Survey ZIPs missing from "
        "2020 ZCTA:",
        missing
    )


print()


# ========================================================
# CALCULATE SURVEY EXTENT
# ========================================================

if survey_boundaries.empty:

    raise RuntimeError(
        "None of the survey ZIPs were found "
        "in the Census ZCTA dataset."
    )


# Work in geographic coordinates for this calculation.
survey_boundaries =
    survey_boundaries.to_crs(
        "EPSG:4326"
    )


minx, miny, maxx, maxy = (
    survey_boundaries.total_bounds
)


print(
    "Survey extent:"
)

print(
    f"  longitude: {minx:.4f} to {maxx:.4f}"
)

print(
    f"  latitude:  {miny:.4f} to {maxy:.4f}"
)

print()


# ========================================================
# ADD SURROUNDING AREA
# ========================================================

region_minx = (
    minx -
    BUFFER_DEGREES
)

region_miny = (
    miny -
    BUFFER_DEGREES
)

region_maxx = (
    maxx +
    BUFFER_DEGREES
)

region_maxy = (
    maxy +
    BUFFER_DEGREES
)


print(
    "Including surrounding ZIPs."
)

print(
    f"  longitude: "
    f"{region_minx:.4f} to "
    f"{region_maxx:.4f}"
)

print(
    f"  latitude: "
    f"{region_miny:.4f} to "
    f"{region_maxy:.4f}"
)

print()


# ========================================================
# SELECT SURROUNDING ZIPs
# ========================================================

regional = zctas[
    (
        zctas.geometry.bounds["maxx"]
        >= region_minx
    )
    &
    (
        zctas.geometry.bounds["minx"]
        <= region_maxx
    )
    &
    (
        zctas.geometry.bounds["maxy"]
        >= region_miny
    )
    &
    (
        zctas.geometry.bounds["miny"]
        <= region_maxy
    )
].copy()


print(
    "Regional ZIP boundaries:",
    len(regional)
)

print()


# ========================================================
# MAKE GEOJSON SMALLER
# ========================================================

regional = regional[
    [
        "ZIP",
        "geometry"
    ]
].copy()


regional = regional.to_crs(
    "EPSG:4326"
)


# ========================================================
# WRITE GEOJSON
# ========================================================

print(
    "Writing:",
    OUTPUT_FILE
)


regional.to_file(
    OUTPUT_FILE,
    driver="GeoJSON"
)


# ========================================================
# FINAL REPORT
# ========================================================

print()
print("=" * 70)
print("DONE")
print("=" * 70)
print()

print(
    f"Survey ZIPs:             {len(survey_zips)}"
)

print(
    f"Survey boundaries:       {len(survey_boundaries)}"
)

print(
    f"Surrounding boundaries:  {len(regional)}"
)

print(
    f"Output file:             {OUTPUT_FILE}"
)

print()

if missing:

    print(
        "NOTE: These survey ZIPs did not have "
        "a matching 2020 ZCTA:"
    )

    for zip_code in missing:

        print(
            f"  {zip_code}"
        )

    print()

print(
    "You can now use:"
)

print(
    "  d3.json('zip-boundaries.geojson')"
)

print(
    "from your HTML."
)

print()


finally:

shutil.rmtree(
    temp_dir,
    ignore_errors=True
)
